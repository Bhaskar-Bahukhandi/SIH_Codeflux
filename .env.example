# Local development settings.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://codeflux:codeflux@localhost:5432/codeflux
MEDIA_ROOT=./local_data/media

# Capture limits
MAX_CAPTURE_MB=12
MAX_CAPTURE_PIXELS=40000000

# Image quality
QUALITY_SHARPNESS_RETAKE=60
QUALITY_SHARPNESS_REVIEW=110
QUALITY_BRIGHTNESS_RETAKE_LOW=40
QUALITY_BRIGHTNESS_RETAKE_HIGH=220
QUALITY_BRIGHTNESS_REVIEW_LOW=60
QUALITY_BRIGHTNESS_REVIEW_HIGH=200
QUALITY_DARK_FRACTION_RETAKE=0.60
QUALITY_BRIGHT_FRACTION_RETAKE=0.60
QUALITY_GLARE_FRACTION_RETAKE=0.08
QUALITY_GLARE_FRACTION_REVIEW=0.03
QUALITY_GLARE_INTENSITY=245
QUALITY_GLARE_SATURATION_MAX=40
QUALITY_GLARE_COMPONENT_MAX_FRACTION=0.08

# Perspective / geometry
GEOMETRY_MIN_AREA_RATIO=0.20
GEOMETRY_MAX_AREA_RATIO=0.95
GEOMETRY_MIN_SIDE_PX=60
GEOMETRY_MIN_ANGLE_SCORE=0.60
GEOMETRY_CORRECTION_SCORE=0.78
GEOMETRY_DETECTION_MAX_DIMENSION=1600
GEOMETRY_CANNY_LOW=60
GEOMETRY_CANNY_HIGH=180
GEOMETRY_APPROXIMATION_EPSILON=0.02

# OCR
OCR_INFERENCE_ENGINE=paddle
OCR_LANGUAGE=en
OCR_MODEL_VERSION=PP-OCRv5
OCR_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
OCR_DEVICE=cpu
OCR_MIN_CONFIDENCE=0.0
OCR_INPUT_MAX_DIMENSION=1600
OCR_DETECTION_MAX_DIMENSION=960
OCR_ENABLE_MKLDNN=false

# Authentication
JWT_SECRET=development-only-change-me-before-production
JWT_ISSUER=codeflux-api
JWT_ACCESS_MINUTES=60
