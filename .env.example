# Phase 0 configuration template.
# Copy to .env locally. Never commit real credentials.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL is the planned central database.
DATABASE_URL=postgresql://codeflux:codeflux@localhost:5432/codeflux

# Local development storage only. Production storage is not frozen in Phase 0.
MEDIA_ROOT=./local_data/media

# Authentication implementation is introduced after the foundation gate.
JWT_SECRET=replace-me-locally
