# Local development configuration template.
# Copy to .env locally. Never commit real credentials.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL is the planned central database.
DATABASE_URL=postgresql+psycopg://codeflux:codeflux@localhost:5432/codeflux

# Local development storage. A replaceable storage adapter is used by the API.
MEDIA_ROOT=./local_data/media
MAX_CAPTURE_MB=12
MAX_CAPTURE_PIXELS=40000000

# Development-only value. Replace it before any shared/staged/production deployment.
JWT_SECRET=development-only-change-me-before-production
JWT_ISSUER=codeflux-api
JWT_ACCESS_MINUTES=60
